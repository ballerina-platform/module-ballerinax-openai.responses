    # - `ne`: not equal
    # - `gt`: greater than
    # - `gte`: greater than or equal
    # - `lt`: less than
    # - `lte`: less than or equal
    # - `in`: in
    # - `nin`: not in
    "eq"|"ne"|"gt"|"gte"|"lt"|"lte"|"in"|"nin" 'type = "eq";
    # The key to compare against the value.
    string 'key;
